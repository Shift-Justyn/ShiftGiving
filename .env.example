# GivingApp Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
# For local development, use the Docker PostgreSQL instance
DATABASE_URL=postgresql://givingapp:givingapp_local_dev@localhost:5432/givingapp

# Session Secret
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-session-secret-here

# Environment
NODE_ENV=development

# API Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5237

# Stripe Configuration (for payment processing)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# AWS Configuration (for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 Configuration (for image uploads)
S3_BUCKET_NAME=givingapp-assets
S3_REGION=us-east-1

# Email Configuration (for receipts and notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@givingapp.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=noreply@givingapp.com

# Logging
LOG_LEVEL=Information

# CORS (allowed origins for web client)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Feature Flags
FEATURE_RECURRING_DONATIONS=false
FEATURE_SOCIAL_SHARING=true
FEATURE_EMAIL_NOTIFICATIONS=true
